# SMTP 密码，请在github上配置，如果为服务器部署，不担心泄露，可以在这里直接写入
SMTP_PWD=123432424

# ---- 功能开关与行为参数 ----
# 已统一收敛到 conf.yaml 的 postprocess 段（geo_diagnose / siteshot / alert 各自的 enable），
# 本文件只保留密钥类环境变量（同 SMTP_PWD 惯例，不落配置文件）。

# ---- 告警渠道（配在 GitHub Secrets；本地调试写这里）----
# QQ 机器人（主渠道）：经 blog-bot Worker 中转的单聊主动消息
# QQ_BOT_ALERT_URL=https://bot.yufish.cn/api/alert
# QQ_BOT_ALERT_TOKEN=与 Worker 的 ALERT_TOKEN 一致
# 企业微信群机器人（兜底）：仅 QQ 未配置或发送失败时使用
# WECOM_WEBHOOK_URL=

# ---- 截图上传 ----
# IMG_UPLOAD_URL=https://imgbed.yufish.cn/upload   # cfbed 兼容上传端点
# IMG_AUTH_CODE=                                    # 上传认证码
